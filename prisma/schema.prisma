model FinanceAccount {
  id                 String               @id @default(cuid())
  name               String
  type               FinanceAccountType
  status             FinanceAccountStatus @default(ACTIVE)
  bankName           String?              @map("bank_name")
  accountNumber      String?              @map("account_number")
  currency           String               @db.VarChar(3)
  baseCurrency       String               @default("AZN") @map("base_currency") @db.VarChar(3)
  exchangeRate       Decimal              @default(1) @map("exchange_rate") @db.Decimal(18, 8)
  openingBalance     Decimal              @default(0) @map("opening_balance") @db.Decimal(14, 2)
  openingBalanceDate DateTime             @default(now()) @map("opening_balance_date") @db.Date
  notes              String?
  sortOrder          Int                  @default(0) @map("sort_order")
  createdById        String?              @map("created_by")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  createdBy               User?                @relation("FinanceAccountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  sourceTransactions      FinanceTransaction[] @relation("FinanceTransactionSourceAccount")
  destinationTransactions FinanceTransaction[] @relation("FinanceTransactionDestinationAccount")

  @@index([status, sortOrder])
  @@index([currency])
  @@index([createdById])

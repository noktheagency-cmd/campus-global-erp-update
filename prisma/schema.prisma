model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String?      @map("password_hash")
  role         UserRole     @default(ADMIN)
  status       EntityStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  createdUniversities                  University[]                 @relation("UniversityCreatedBy")
  createdAgents                        Agent[]                      @relation("AgentCreatedBy")
  createdStudents                      Student[]                    @relation("StudentCreatedBy")
  createdApplications                  Application[]                @relation("ApplicationCreatedBy")
  decidedApplicationChoices            ApplicationChoice[]          @relation("ApplicationChoiceDecidedBy")
  agentPortal                          Agent?                       @relation("AgentPortalUser")
  studentPortal                        Student?                     @relation("StudentPortalUser")
  uploadedDocuments                    UniversityDocument[]         @relation("DocumentUploadedBy")
  uploadedStudentDocuments             StudentDocument[]            @relation("StudentDocumentUploadedBy")
  uploadedApplicationDocuments         ApplicationDocument[]        @relation("ApplicationDocumentUploadedBy")
  reviewedApplicationDocuments         ApplicationDocument[]        @relation("ApplicationDocumentReviewedBy")
  createdApplicationDocumentRequests   ApplicationDocumentRequest[] @relation("ApplicationDocumentRequestCreatedBy")
  respondedApplicationDocumentRequests ApplicationDocumentRequest[] @relation("ApplicationDocumentRequestRespondedBy")
  createdServices                      Service[]                    @relation("ServiceCreatedBy")
  createdServicePrices                 ServicePrice[]               @relation("ServicePriceCreatedBy")
  createdServiceOrders                 ServiceOrder[]               @relation("ServiceOrderCreatedBy")
  createdServiceQuoteRequests          ServiceQuoteRequest[]        @relation("ServiceQuoteRequestCreatedBy")
  reviewedServiceQuoteRequests         ServiceQuoteRequest[]        @relation("ServiceQuoteRequestReviewedBy")
  createdDocumentOrders                DocumentOrder[]              @relation("DocumentOrderCreatedBy")
  managedDocumentOrders                DocumentOrder[]              @relation("DocumentOrderManager")
  changedDocumentOrderStatuses         DocumentOrderStatusHistory[] @relation("DocumentOrderStatusChangedBy")
  createdFinanceAccounts               FinanceAccount[]             @relation("FinanceAccountCreatedBy")
  createdFinanceCategories             FinanceCategory[]            @relation("FinanceCategoryCreatedBy")
  createdFinanceTransactions           FinanceTransaction[]         @relation("FinanceTransactionCreatedBy")
  postedFinanceTransactions            FinanceTransaction[]         @relation("FinanceTransactionPostedBy")
  voidedFinanceTransactions            FinanceTransaction[]         @relation("FinanceTransactionVoidedBy")
  createdFinanceObligations            FinanceObligation[]          @relation("FinanceObligationCreatedBy")
  createdFinanceBudgets                FinanceBudget[]              @relation("FinanceBudgetCreatedBy")
  financeAuditLogs                     FinanceAuditLog[]
  createdCommissionAgreements          CommissionAgreement[]        @relation("CommissionAgreementCreatedBy")
  createdUniversityCommissionAgreements UniversityCommissionAgreement[] @relation("UniversityCommissionAgreementCreatedBy")
  activatedCommissionAgreements        CommissionAgreement[]        @relation("CommissionAgreementActivatedBy")
  createdCommissionPayments            CommissionPayment[]          @relation("CommissionPaymentCreatedBy")
  postedCommissionPayments             CommissionPayment[]          @relation("CommissionPaymentPostedBy")
  approvedCommissionCalculations       CommissionCalculation[]      @relation("CommissionCalculationApprovedBy")
  commissionAuditLogs                  CommissionAuditLog[]
  createdCommissionPackages            CommissionPackage[]          @relation("CommissionPackageCreatedBy")
  createdCommissionTermVersions        CommissionTermVersion[]      @relation("CommissionTermVersionCreatedBy")
  reviewedCommissionPackageAgreements  CommissionPackageAgreement[] @relation("CommissionPackageAgreementReviewedBy")
  createdScholarshipRedemptions        AgentScholarshipRedemption[] @relation("AgentScholarshipRedemptionCreatedBy")
  ownedCrmProfiles                     CrmProfile[]                 @relation("CrmProfileOwner")
  createdCrmProfiles                   CrmProfile[]                 @relation("CrmProfileCreatedBy")
  assignedCrmTasks                     CrmTask[]                    @relation("CrmTaskAssignedTo")
  createdCrmTasks                      CrmTask[]                    @relation("CrmTaskCreatedBy")
  authoredCrmInteractions              CrmInteraction[]             @relation("CrmInteractionAuthor")
  requestedSupportTickets              SupportTicket[]              @relation("SupportTicketRequester")
  assignedSupportTickets               SupportTicket[]              @relation("SupportTicketAssignee")
  authoredSupportMessages              SupportTicketMessage[]       @relation("SupportTicketMessageAuthor")
  uploadedSupportAttachments           SupportTicketAttachment[]    @relation("SupportTicketAttachmentUploadedBy")
  supportTicketActivities              SupportTicketActivity[]      @relation("SupportTicketActivityActor")
  createdHrEmployees                   HrEmployee[]                 @relation("HrEmployeeCreatedBy")
  createdHrAttendance                  HrAttendance[]               @relation("HrAttendanceCreatedBy")
  reviewedHrLeaveRequests              HrLeaveRequest[]             @relation("HrLeaveReviewedBy")
  createdHrVacancies                   HrVacancy[]                  @relation("HrVacancyCreatedBy")
  createdHrCandidates                  HrCandidate[]                @relation("HrCandidateCreatedBy")
  createdHrPerformanceReviews          HrPerformanceReview[]        @relation("HrPerformanceReviewCreatedBy")
  createdHrPayrollRuns                 HrPayrollRun[]               @relation("HrPayrollRunCreatedBy")
  approvedHrPayrollRuns                HrPayrollRun[]               @relation("HrPayrollRunApprovedBy")
  notes                                UniversityNote[]
  activities                           ActivityLog[]

  @@map("users")
}

model Agent {
  id                      String            @id @default(cuid())
  firstName               String            @map("first_name")
  lastName                String            @map("last_name")
  companyName             String?           @map("company_name")
  logoUrl                 String?           @map("logo_url")
  profilePhotoUrl         String?           @map("profile_photo_url")
  email                   String            @unique
  passwordHash            String?           @map("password_hash")
  phone                   String?
  country                 String?
  address                 String?
  instagramUrl            String?           @map("instagram_url")
  internalNotes           String?           @map("internal_notes")
  portalStatus            AgentPortalStatus @default(PENDING) @map("portal_status")
  tier                    AgentTier         @default(STARTER)
  canRegisterStudents     Boolean           @default(true) @map("can_register_students")
  ownStudentsOnly         Boolean           @default(true) @map("own_students_only")
  portalReporting         Boolean           @default(true) @map("portal_reporting")
  registeredStudentsCount Int               @default(0) @map("registered_students_count")
  activeApplicationsCount Int               @default(0) @map("active_applications_count")
  conversionRate          Int               @default(0) @map("conversion_rate")
  commissionBalance       Decimal           @default(0) @map("commission_balance") @db.Decimal(12, 2)
  cashPayoutActive        Boolean           @default(true) @map("cash_payout_active")
  accountPayoutActive     Boolean           @default(true) @map("account_payout_active")
  holdInAccount           Boolean           @default(false) @map("hold_in_account")
  manualPayoutManagement  Boolean           @default(false) @map("manual_payout_management")
  payoutPercentage        Decimal           @default(100) @map("payout_percentage") @db.Decimal(5, 2)
  userId                  String?           @unique @map("user_id")
  createdById             String?           @map("created_by")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  portalUser                  User?                        @relation("AgentPortalUser", fields: [userId], references: [id], onDelete: SetNull)
  createdBy                   User?                        @relation("AgentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  students                    Student[]
  applications                Application[]
  socialLinks                 AgentSocialLink[]
  contacts                    AgentContact[]
  notifications               AgentNotification[]
  servicePrices               ServicePrice[]
  serviceOrders               ServiceOrder[]
  serviceQuoteRequests        ServiceQuoteRequest[]
  documentOrders              DocumentOrder[]
  crmProfile                  CrmProfile?
  commissionAgreements        CommissionAgreement[]
  commissionCalculations      CommissionCalculation[]
  commissionPackageAgreements CommissionPackageAgreement[]
  scholarshipRedemptions      AgentScholarshipRedemption[]

  @@index([country])
  @@index([portalStatus])
  @@index([tier])
  @@index([createdById])
  @@map("agents")
}

model AgentSocialLink {
  id        String              @id @default(cuid())
  agentId   String              @map("agent_id")
  platform  AgentSocialPlatform
  url       String
  label     String?
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, platform, url])
  @@index([agentId])
  @@map("agent_social_links")
}

model AgentContact {
  id        String   @id @default(cuid())
  agentId   String   @map("agent_id")
  fullName  String   @map("full_name")
  position  String?
  email     String?
  phone     String?
  whatsapp  String?
  isPrimary Boolean  @default(false) @map("is_primary")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([agentId, isPrimary])
  @@map("agent_contacts")
}

model AgentNotification {
  id         String                @id @default(cuid())
  agentId    String                @map("agent_id")
  type       AgentNotificationType @default(SYSTEM)
  title      String
  message    String
  actionHref String?               @map("action_href")
  entityType RelatedEntityType?    @map("entity_type")
  entityId   String?               @map("entity_id")
  readAt     DateTime?             @map("read_at")
  createdAt  DateTime              @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@index([agentId, readAt, createdAt])
  @@map("agent_notifications")
}

model Student {
  id            String       @id @default(cuid())
  firstName     String       @map("first_name")
  lastName      String       @map("last_name")
  fatherName    String?      @map("father_name")
  motherName    String?      @map("mother_name")
  birthDate     DateTime?    @map("birth_date")
  contactEmail  String?      @unique @map("contact_email")
  loginEmail    String?      @unique @map("login_email")
  passwordHash  String?      @map("password_hash")
  phone         String?
  address       String?
  passportNo    String?      @unique @map("passport_no")
  identityNo    String?      @unique @map("identity_no")
  citizenship   String?
  gender        String?
  maritalStatus String?      @map("marital_status")
  photoUrl      String?      @map("photo_url")
  stage         String       @default("Profile")
  status        EntityStatus @default(ACTIVE)
  portalStatus  String       @default("PENDING") @map("portal_status")
  userId        String?      @unique @map("user_id")
  agentId       String?      @map("agent_id")
  createdById   String?      @map("created_by")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  portalUser             User?                   @relation("StudentPortalUser", fields: [userId], references: [id], onDelete: SetNull)
  agent                  Agent?                  @relation(fields: [agentId], references: [id], onDelete: SetNull)
  createdBy              User?                   @relation("StudentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  applications           Application[]
  documents              StudentDocument[]
  serviceOrders          ServiceOrder[]
  documentOrders         DocumentOrder[]
  crmProfile             CrmProfile?
  commissionCalculations CommissionCalculation[]
  scholarshipRedemptions AgentScholarshipRedemption[]

  @@index([agentId])
  @@index([citizenship])
  @@index([createdById])
  @@index([status])
  @@index([stage])
  @@map("students")
}

model StudentDocument {
  id           String   @id @default(cuid())
  studentId    String   @map("student_id")
  title        String
  documentType String   @map("document_type")
  fileUrl      String   @map("file_url")
  fileName     String   @map("file_name")
  fileSize     Int      @map("file_size")
  mimeType     String   @map("mime_type")
  uploadedById String?  @map("uploaded_by")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation("StudentDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([uploadedById])
  @@index([documentType])
  @@map("student_documents")
}

model University {
  id                         String            @id @default(cuid())
  name                       String
  logoUrl                    String?           @map("logo_url")
  country                    String
  city                       String
  website                    String?
  newsSourceUrl              String?           @map("news_source_url")
  schoolType                 SchoolType        @map("school_type")
  partnershipStatus          PartnershipStatus @default(PROSPECT) @map("partnership_status")
  agreementStatus            AgreementStatus?  @map("agreement_status")
  mainEmail                  String?           @map("main_email")
  mainPhone                  String?           @map("main_phone")
  internalNotes              String?           @map("internal_notes")
  defaultPeriodId            String?           @map("default_period_id")
  defaultEducationLevelId    String?           @map("default_education_level_id")
  defaultEducationLanguageId String?           @map("default_education_language_id")
  defaultCurrency            String?           @map("default_currency") @db.VarChar(3)
  newsLastSyncedAt           DateTime?         @map("news_last_synced_at")
  status                     EntityStatus      @default(ACTIVE)
  createdById                String?           @map("created_by")
  createdAt                  DateTime          @default(now()) @map("created_at")
  updatedAt                  DateTime          @updatedAt @map("updated_at")

  createdBy                       User?                                  @relation("UniversityCreatedBy", fields: [createdById], references: [id])
  defaultPeriod                   Period?                                @relation("UniversityDefaultPeriod", fields: [defaultPeriodId], references: [id], onDelete: SetNull)
  defaultEducationLevel           EducationLevel?                        @relation("UniversityDefaultEducationLevel", fields: [defaultEducationLevelId], references: [id], onDelete: SetNull)
  defaultEducationLanguage        EducationLanguage?                     @relation("UniversityDefaultEducationLanguage", fields: [defaultEducationLanguageId], references: [id], onDelete: SetNull)
  availablePeriods                UniversityPeriod[]
  availableEducationLevels        UniversityEducationLevel[]
  availableEducationLanguages     UniversityEducationLanguage[]
  availableCurrencies             UniversityCurrency[]
  campuses                        Campus[]
  contacts                        UniversityContact[]
  programs                        Program[]
  documents                       UniversityDocument[]
  applicationChoices              ApplicationChoice[]
  notes                           UniversityNote[]
  news                            UniversityNews[]
  commissionAgreements            CommissionAgreement[]
  universityCommissionAgreements  UniversityCommissionAgreement[]
  commissionCalculations          CommissionCalculation[]
  commissionPackageLinks          CommissionPackageUniversity[]
  commissionPackageAgreementLinks CommissionPackageAgreementUniversity[]

  @@unique([name, country])
  @@index([country, city])
  @@index([partnershipStatus])
  @@index([status])
  @@index([createdById])
  @@index([defaultPeriodId])
  @@index([defaultEducationLevelId])
  @@index([defaultEducationLanguageId])
  @@index([defaultCurrency])
  @@map("universities")
}

model Campus {
  id           String       @id @default(cuid())
  universityId String       @map("university_id")
  name         String
  country      String
  city         String
  address      String?
  imageUrl     String?      @map("image_url")
  latitude     Decimal?     @db.Decimal(10, 7)
  longitude    Decimal?     @db.Decimal(10, 7)
  isMainCampus Boolean      @default(false) @map("is_main_campus")
  status       EntityStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  university University @relation(fields: [universityId], references: [id], onDelete: Restrict)
  programs   Program[]

  @@unique([universityId, name])
  @@index([country, city])
  @@map("campuses")
}

model EducationLevel {
  id        String       @id @default(cuid())
  name      String       @unique
  status    EntityStatus @default(ACTIVE)
  sortOrder Int          @default(0) @map("sort_order")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  programs               Program[]
  applications           Application[]
  defaultForUniversities University[]               @relation("UniversityDefaultEducationLevel")
  universityLinks        UniversityEducationLevel[]

  @@map("education_levels")
}

model EducationLanguage {
  id        String       @id @default(cuid())
  name      String       @unique
  status    EntityStatus @default(ACTIVE)
  sortOrder Int          @default(0) @map("sort_order")
  createdAt DateTime     @default(now()) @map("created_at")

  hiredAt                  DateTime           @map("hired_at") @db.Date
  contractEndDate          DateTime?          @map("contract_end_date") @db.Date
  terminatedAt             DateTime?          @map("terminated_at") @db.Date
  employmentStatus         HrEmploymentStatus @default(ACTIVE) @map("employment_status")
  employmentType           HrEmploymentType   @default(FULL_TIME) @map("employment_type")
  workMode                 HrWorkMode         @default(ONSITE) @map("work_mode")

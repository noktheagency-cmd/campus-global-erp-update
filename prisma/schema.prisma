model FinanceCategory {
  id          String               @id @default(cuid())
  name        String
  type        FinanceCategoryType
  status      FinanceAccountStatus @default(ACTIVE)
  isSystem    Boolean              @default(false) @map("is_system")
  sortOrder   Int                  @default(0) @map("sort_order")
  createdById String?              @map("created_by")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  createdBy    User?                @relation("FinanceCategoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  transactions FinanceTransaction[]
  obligations  FinanceObligation[]
  budgetLines  FinanceBudgetLine[]

  @@unique([type, name])
  @@index([status, type, sortOrder])
  @@index([createdById])
  @@map("finance_categories")
}

model FinanceTransaction {
  id                   String                   @id @default(cuid())
  code                 String                   @unique
  type                 FinanceTransactionType
  status               FinanceTransactionStatus @default(POSTED)
  accountId            String                   @map("account_id")
  destinationAccountId String?                  @map("destination_account_id")
  categoryId           String?                  @map("category_id")
  amount               Decimal                  @db.Decimal(14, 2)
  baseAmount           Decimal                  @map("base_amount") @db.Decimal(14, 2)
  baseCurrency         String                   @default("AZN") @map("base_currency") @db.VarChar(3)
  destinationAmount    Decimal?                 @map("destination_amount") @db.Decimal(14, 2)
  currency             String                   @db.VarChar(3)
  destinationCurrency  String?                  @map("destination_currency") @db.VarChar(3)
  exchangeRate         Decimal                  @default(1) @map("exchange_rate") @db.Decimal(18, 8)
  effectiveAt          DateTime                 @map("effective_at") @db.Date
  counterpartyType     FinanceCounterpartyType? @map("counterparty_type")
  counterpartyName     String?                  @map("counterparty_name")
  reference            String?
  description          String?
  relatedEntityType    RelatedEntityType?       @map("related_entity_type")
  relatedEntityId      String?                  @map("related_entity_id")
  createdById          String?                  @map("created_by")
  postedById           String?                  @map("posted_by")
  postedAt             DateTime?                @map("posted_at")
  voidedById           String?                  @map("voided_by")
  voidedAt             DateTime?                @map("voided_at")
  voidReason           String?                  @map("void_reason")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  account            FinanceAccount      @relation("FinanceTransactionSourceAccount", fields: [accountId], references: [id], onDelete: Restrict)
  destinationAccount FinanceAccount?     @relation("FinanceTransactionDestinationAccount", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  category           FinanceCategory?    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy          User?               @relation("FinanceTransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  postedBy           User?               @relation("FinanceTransactionPostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  voidedBy           User?               @relation("FinanceTransactionVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  settlements        FinanceSettlement[]
  commissionPayment  CommissionPayment?

  @@index([status, effectiveAt])
  @@index([type, status, effectiveAt])
  @@index([accountId, status, effectiveAt])
  @@index([destinationAccountId, status, effectiveAt])
  @@index([categoryId, status, effectiveAt])
  @@index([counterpartyType, counterpartyName])
  @@index([relatedEntityType, relatedEntityId])
  @@index([createdById])
  @@index([postedById])
  @@index([voidedById])
  @@map("finance_transactions")
}

model FinanceObligation {
  id                String                  @id @default(cuid())
